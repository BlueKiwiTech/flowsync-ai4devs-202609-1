{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-frontend.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting frontend file with Prettier..."
          }
        ]
      }
    ]
  }
}
